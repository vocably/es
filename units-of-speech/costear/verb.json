{"transcript":"kos.te.ˈaɾ","exists":true,"definitions":["Pagar los gastos de algo.","Navegar siguiendo la costa, sin alejarse de ella.","Sufragar o financiar una actividad o necesidad."],"examples":["Mis padres costean mis estudios.","El barco costeaba la isla.","La empresa costeará el viaje."],"lemma":"costear","lemmaPos":"verb","synonyms":["pagar","sufragar","financiar","sostener"],"number":"singular","frequency":5,"tense":"present","pastTenses":"costeé (pretérito indefinido); he costeado (pretérito perfecto)","source":"costear"}