{"transcript":"pɾesaˈxjaɾ","exists":true,"definitions":["Anunciar o predecir algo futuro a partir de señales o indicios.","Prever que va a suceder algo, generalmente negativo."],"examples":["Las nubes negras presagian tormenta.","Ese silencio presagiaba problemas.","Nadie presagió el desenlace."],"lemma":"presagiar","lemmaPos":"verb","synonyms":["predecir","augurar","pronosticar","vaticinar","anunciar"],"number":"singular","frequency":3,"tense":"present","pastTenses":"presagió; ha presagiado","source":"presagiar"}