{"transcript":"paˈsaɾ duɾˈmjendo","exists":true,"definitions":["Dedicar un periodo de tiempo a dormir, estando dormido durante todo ese tiempo.","Estar dormido mientras transcurre un evento o un lapso, sin enterarse de lo que ocurre."],"examples":["Pasó durmiendo todo el domingo.","Se pasa durmiendo las tardes.","Pasamos durmiendo el viaje entero."],"lemma":"pasar durmiendo","lemmaPos":"verb phrase","synonyms":["pasarse durmiendo","dormir todo el tiempo","echarse a dormir","pasar dormido"],"number":"singular","frequency":5,"tense":"present","pastTenses":"pasó durmiendo; ha pasado durmiendo","source":"pasar durmiendo"}