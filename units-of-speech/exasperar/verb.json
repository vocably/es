{"transcript":"ek.sas.pe.ˈɾaɾ","exists":true,"definitions":["Irritar o enfurecer en extremo a alguien.","Agravar o enardecer una pasión, un dolor o una situación.","Hacer perder la paciencia a alguien."],"examples":["Su tardanza me exaspera.","Los ruidos constantes lo exasperaron.","No quiero exasperarte más."],"lemma":"exasperar","lemmaPos":"verb","synonyms":["irritar","enfurecer","enojar","crispar","sulfurar"],"number":"singular","frequency":4,"tense":"present","pastTenses":"exasperé (pretérito indefinido); he exasperado (pretérito perfecto)","source":"exasperar"}