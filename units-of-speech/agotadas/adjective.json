{"transcript":"aɣoˈtaðas","exists":true,"definitions":["Extremadamente cansadas, sin fuerzas.","Que se han terminado o consumido por completo, especialmente existencias de un producto.","Que no tienen más disponibilidad o ya no se venden."],"examples":["Estaban agotadas tras la carrera.","Las entradas están agotadas.","Las existencias quedaron agotadas."],"lemma":"agotado","lemmaPos":"adjective","synonyms":["cansadas","exhaustas","extenuadas","vendidas"],"number":"plural","frequency":6,"gender":"feminine","source":"agotadas"}