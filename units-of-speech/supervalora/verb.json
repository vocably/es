{"transcript":"su.per.βa.ˈlo.ɾa","exists":true,"definitions":["Tercera persona singular del presente de indicativo de supervalorar: atribuir a algo o alguien más valor del que realmente tiene.","Forma imperativa (tú) de supervalorar: sobrestima."],"examples":["Ella supervalora su experiencia.","El mercado supervalora esas acciones.","No supervalora el esfuerzo ajeno."],"lemma":"supervalorar","lemmaPos":"verb","synonyms":["sobrevalorar","sobrestimar","magnificar","exagerar"],"number":"singular","frequency":2,"tense":"present","pastTenses":"supervaloró; ha supervalorado","source":"supervalora"}