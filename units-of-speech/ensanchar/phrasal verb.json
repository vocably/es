{"transcript":"en.san.ˈtʃaɾ","exists":true,"definitions":["Hacer más ancho algo, aumentar su anchura.","Extender o dilatar algo para que ocupe más espacio.","Ampliar un lugar, una calle o una prenda."],"examples":["Quieren ensanchar la carretera.","Tengo que ensanchar esta falda.","Ensancharon el cauce del río."],"lemma":"ensanchar","lemmaPos":"verb","synonyms":["ampliar","agrandar","dilatar","extender"],"number":"singular","frequency":5,"tense":"present","pastTenses":"ensanché; he ensanchado","source":"ensanchar"}