{"transcript":"es.tu.pe.fak.ˈsjon","exists":true,"definitions":["Asombro o pasmo muy grande que deja a alguien sin capacidad de reacción.","Estado de quien queda atónito ante algo inesperado."],"examples":["Miró la escena con estupefacción.","Su respuesta me causó estupefacción.","La noticia provocó estupefacción general."],"lemma":"estupefacción","lemmaPos":"noun","synonyms":["asombro","pasmo","perplejidad","sorpresa","estupor"],"number":"singular","frequency":3,"pluralForm":"las estupefacciones","gender":"feminine","source":"estupefacción"}