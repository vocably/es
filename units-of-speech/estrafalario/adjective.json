{"transcript":"es.tɾa.fa.ˈla.ɾjo","exists":true,"definitions":["Extravagante, raro o desaliñado en su forma de vestir o comportarse.","Que resulta extraño, ridículo o fuera de lo común."],"examples":["Llevaba un sombrero estrafalario.","Tiene ideas muy estrafalarias.","Vestía de forma estrafalaria."],"lemma":"estrafalario","lemmaPos":"adjective","synonyms":["extravagante","excéntrico","raro","chocante","extraño"],"number":"singular","frequency":4,"gender":"masculine","source":"estrafalario"}